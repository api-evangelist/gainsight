{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gainsight CS Bulk Accounts Custom Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "accessKey",
      "value": "{{accessKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Custom Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gainsight Send a custom event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.gainsightcloud.com/v1/custom_events",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send a custom event for a user to track specific interactions."
        }
      ]
    }
  ],
  "bundled": true
}