                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "objectName",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Target Gainsight object name"
                },
                {
                  "key": "operation",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Bulk operation type (This can only be one of INSERT,UPDATE,UPSERT)"
