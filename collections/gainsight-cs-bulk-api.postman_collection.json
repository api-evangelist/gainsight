          "name": "Gainsight Create a bulk job",
          "request": {
            "name": "Gainsight Create a bulk job",
            "description": {
              "content": "Create a new bulk import job to insert or update records from a CSV file into a Gainsight object. Rate limited to 10 calls per hour and 100 per day.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "bulk",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Customer-specific domain prefix",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "objectName",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Target Gainsight object name"
                },
                {
                  "key": "operation",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Bulk operation type (This can only be one of INSERT,UPDATE,UPSERT)"
                },
                {
                  "key": "file",
