                  "id": "4b4b5ba8-ca2a-4ece-9c5d-973d46d9f51d",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "*/*"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/v1/survey/responses?filter=<string>&filter=<string>&pageSize=25&scrollId=<string>&sort=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "v1",
                        "survey",
                        "responses"
                      ],
                      "query": [
                        {
                          "description": "Filters",
                          "key": "filter",
                          "value": "<string>"
                        },
                        {
                          "description": "Filters",
                          "key": "filter",
                          "value": "<string>"
                        },
                        {
                          "description": "Number of responses per page",
                          "key": "pageSize",
                          "value": "25"
                        },
                        {
                          "description": "Used for fetching subsequent pages after the first one.  Returned in response.scrollId",
                          "key": "scrollId",
                          "value": "<string>"
                        },
                        {
                          "description": "Sort fields",
                          "key": "sort",
                          "value": "<string>"
                        }
                      ]
                    },
                    "description": "Retrieves Survey responses. Supports filtering, sorting and paging.\n### Filtering\nThe filter parameter accepts a list of semicolon-separated filters in the form: {fieldName}{operator}{fieldValue}\nFilter terms within a single filter parameter are joined by a logical AND.\nSeparate filter parameters are joined by a logical OR.\n#### Supported filter fields\n| Field |\n| ----- |\n| identifyId |\n| accountId |\n| date (as epoch milliseconds value)|\n| contentType (IN_APP_SURVEY_NPS,IN_APP_SURVEY_CES,IN_APP_SURVEY_BOOLEAN,IN_APP_SURVEY_RATING, IN_APP_MULTIPLE_QUESTION_SURVEY)|\n\n#### Operators\n| Operator | Meaning |\n| ----- | -------- |\n| == | Exact match |\n| != | Not equal |\n| | Greater than |\n| >= | Greater than or equal |\n| ~ | Matches string, supports wildcard characters * and ? |\n| !~ | Not like, supports wildcard characters * and ? |\n\nExamples:\n\n| URI | Results |\n| ----- | -------- |\n| GET /v1/survey/responses?filter=identifyId==ABC123 | Survey responses for user with identifyId of 'ABC123'. |\n\n### Sorting\nThe sort parameter accepts a list of semi-colon separated fields names, each with an optional dash to imply descending sort order.\n#### Supported sort fields\n| Field |\n| ----- |\n| accountId |\n| date |\n\nExamples:\n\n| URI | Results |\n| ----- | -------- |\n| GET /v1/survey/responses?sort=-date | Matches sorted by date descending. |"
                  },
