{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gainsight CS Bulk Accounts Tasks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "accessKey",
      "value": "{{accessKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gainsight Create a task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.gainsightcloud.com/v1/tasks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new task associated with a CTA."
        },
        {
          "info": {
            "name": "Gainsight Get a task",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.gainsightcloud.com/v1/tasks/:taskId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "Task unique identifier"
              }
            ]
          },
          "docs": "Retrieve a specific task by ID."
        },
        {
          "info": {
            "name": "Gainsight Update a task",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{domain}.gainsightcloud.com/v1/tasks/:taskId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "Task unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing task."
        },
        {
          "info": {
            "name": "Gainsight Search tasks",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.gainsightcloud.com/v1/tasks/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search for tasks using filter criteria."
        }
      ]
    }
  ],
  "bundled": true
}