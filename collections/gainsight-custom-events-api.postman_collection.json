                        "key": "Accept",
                        "value": "*/*"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/v1/events/custom?dateRangeEnd=<string>&dateRangeStart=<string>&filter=<string>&filter=<string>&pageSize=25&scrollId=<string>&sort=<string>",
