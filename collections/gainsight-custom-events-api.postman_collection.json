                        "{{baseUrl}}"
                      ],
                      "path": [
                        "v1",
                        "events",
                        "custom"
                      ],
                      "query": [
                        {
                          "description": "Date range end",
                          "key": "dateRangeEnd",
                          "value": "<string>"
                        },
                        {
                          "description": "Date range start",
                          "key": "dateRangeStart",
                          "value": "<string>"
                        },
                        {
                          "description": "Filters",
                          "key": "filter",
                          "value": "<string>"
                        },
                        {
                          "description": "Filters",
                          "key": "filter",
                          "value": "<string>"
                        },
                        {
                          "description": "Number of events per page",
                          "key": "pageSize",
                          "value": "25"
                        },
                        {
                          "description": "Used for fetching subsequent pages after the first one.  Returned in response.scrollId",
                          "key": "scrollId",
                          "value": "<string>"
                        },
                        {
                          "description": "Sort fields",
                          "key": "sort",
                          "value": "<string>"
                        }
                      ]
                    },
                    "description": "Retrieves custom events. Supports filtering, sorting and paging.\n### Filtering\nThe filter parameter accepts a list of semicolon-separated filters in the form: {fieldName}{operator}{fieldValue}\nFilter terms within a single filter parameter are joined by a logical AND.\nSeparate filter parameters are joined by a logical OR.\n#### Supported filter fields\n| Field |\n| ----- |\n| identifyId |\n| eventName |\n| date |\n\n#### Operators\n| Operator | Meaning |\n| ----- | -------- |\n| == | Exact match |\n| != | Not equal |\n| | Greater than |\n| >= | Greater than or equal |\n| ~ | Matches string, supports wildcard characters * and ? |\n| !~ | Not like, supports wildcard characters * and ? |\n\nExamples:\n\n| URI | Results |\n| ----- | -------- |\n| GET /v1/events/custom?filter=identifyId==ABC123 | Custom event matches for user with identifyId of 'ABC123'. |\n\n### Sorting\nThe sort parameter accepts a list of semi-colon separated fields names, each with an optional dash to imply descending sort order.\n#### Supported sort fields\n| Field |\n| ----- |\n| accountId |\n| date |\n\nExamples:\n\n| URI | Results |\n| ----- | -------- |\n| GET /v1/events/custom?sort=-date | Matches sorted by date descending. |"
                  },
