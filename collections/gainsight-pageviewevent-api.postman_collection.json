                        "key": "Accept",
                        "value": "*/*"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/v1/events/pageView?filter=<string>&filter=<string>&pageSize=25&scrollId=<string>&sort=<string>",
